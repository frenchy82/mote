<?xml version="1.0" encoding="UTF-8"?>
<!-- The app icons, built into the binary (build.rs) so a run straight from
     target/ shows them too. GTK searches <base path>/icons as part of hicolor. -->
<gresources>
  <gresource prefix="/co/hyprlab/Mote">
    <file alias="icons/scalable/apps/co.hyprlab.Mote.svg">icons/hicolor/scalable/apps/co.hyprlab.Mote.svg</file>
    <file alias="icons/symbolic/apps/co.hyprlab.Mote-symbolic.svg">icons/hicolor/symbolic/apps/co.hyprlab.Mote-symbolic.svg</file>
  </gresource>
</gresources>
